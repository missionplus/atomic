# Example: env vars a consuming application sets to point at the fake
# instead of the real upstream. Names are illustrative — match the env vars
# the consuming app actually reads.

# Base URL of the fake (override per-service in the consumer's config).
ORDERS_SERVICE_URL=http://localhost:8000

# Auth: the fake accepts any well-formed bearer token. Use whatever your
# consumer's config layer expects.
ORDERS_SERVICE_TOKEN=fake-token

# If the consumer has client-side timeouts, keep them generous so the fake
# isn't flaky on a cold start.
ORDERS_SERVICE_TIMEOUT_MS=5000

# If the consumer subscribes to events the real service publishes, point its
# broker config at an in-memory or local broker — see /fake/README.md for the
# event surfaces this fake publishes.
EVENTS_BROKER_URL=memory://local
